# Used only by `docker compose` to configure the Postgres/Redis containers
# and to fill in the ${...} placeholders in docker-compose.yml. Copy to
# `.env` at the repo root before running `docker compose up`.
#
# Each app's own runtime configuration (JWT secrets, API URLs, etc.) lives
# in apps/api/.env.example and apps/web/.env.example instead — copy those
# to apps/api/.env and apps/web/.env respectively.

POSTGRES_USER=khatanepal
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=khatanepal
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
