NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://khatanepal:change_me_in_production@localhost:5432/khatanepal?schema=public

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Server ───────────────────────────────────────────────────────────────
API_PORT=4000
API_PREFIX=api/v1
# Comma-separated list of allowed frontend origins, e.g.:
# CORS_ORIGIN=https://your-app.vercel.app,https://your-preview.vercel.app
CORS_ORIGIN=http://localhost:3000
# "lax" only works when the frontend and API share the same registrable
# domain. If the frontend is on a different domain (e.g. Vercel, or a
# separate Hostinger subdomain) than this API, set this to "none" —
# required for the login/refresh cookie to work cross-site. Only valid
# over HTTPS (this API must be served with a real TLS certificate for
# SameSite=None cookies to be honored by the browser).
COOKIE_SAME_SITE=lax

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt rounds
BCRYPT_SALT_ROUNDS=12

# Company defaults (used to seed the demo organization)
DEFAULT_ORG_NAME="KhataNepal Demo Supermarket"
DEFAULT_ORG_PAN=123456789
DEFAULT_VAT_RATE=13

# ─── Payment gateways (Nepal) — sandbox keys ──────────────────────────────
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_MODE=sandbox

KHALTI_PUBLIC_KEY=test_public_key
KHALTI_SECRET_KEY=test_secret_key
KHALTI_MODE=sandbox

FONEPAY_MERCHANT_CODE=
FONEPAY_SECRET_KEY=

# ─── AI insights (optional; falls back to heuristic engine if unset) ──────
ANTHROPIC_API_KEY=
AI_INSIGHTS_PROVIDER=heuristic
