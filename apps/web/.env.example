# Point this at the API's base URL, including the /api/v1 prefix.
# This is a build-time variable in Next.js — after changing it you must
# rebuild/redeploy, saving it alone is not enough.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

NEXT_PUBLIC_APP_NAME=KhataNepal
NEXT_PUBLIC_DEFAULT_CURRENCY=NPR
